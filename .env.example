# ===================================================
# ReachInbox Email Scheduler - Root Environment Example
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL 8.0)
DATABASE_URL="mysql://reachinbox_user:reachinbox_password@localhost:3307/reachinbox_scheduler"

# Redis (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# Elasticsearch (Email Search)
ELASTICSEARCH_URL="http://localhost:9200"

# Future Phases (Credentials placeholders)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ETHEREAL_USER=your_ethereal_username
# ETHEREAL_PASS=your_ethereal_password
